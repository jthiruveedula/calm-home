<?xml version="1.0" encoding="utf-8"?>
<!-- Calm Home asks for one permission: INTERNET, used only by Photo Drop to receive photos from a phone on the
     same Wi-Fi while the Photo Drop screen is open. It never connects out to the internet. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jay.calmhome">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="Calm Home"
        android:supportsRtl="false"
        android:theme="@style/Calm">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/banner"
            android:icon="@drawable/icon"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
